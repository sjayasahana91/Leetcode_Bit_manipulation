  x =abs(x); y= abs(y);
  if(a*b > 0)
  {
    int sum_without_carry = 0, carry = 0;
    while(y!=0)
    {
      sum_without_carry = x^y;
      carry = (x&y) << 1;
      x = sum_without_carry;
      y = carry;
    }
  }
  else {
    int diff_without_borrow = 0, borrow = 0;
    while(y!=0)
    {
      diff_without_borrow = x^y;
      borrow = ((~x) & y) <<1;

      x = diff_without_borrow;
      y = borrow;
    }
  }
  return (x*sign);
}

