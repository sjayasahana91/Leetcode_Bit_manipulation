You are given an array of positive integers nums.
A subarray is called nice if no two elements in the subarray share a common set bit in their binary representation.
Formally, for every pair (i, j) in the subarray with i != j, (nums[i] & nums[j]) == 0.
Return the length of the longest nice subarray.
Examples
Input: nums = [1, 3, 8, 48, 10]
Binary:
1 = 0001
3 = 0011
8 = 1000
48 = 110000
10 = 01010
One longest nice subarray is [3, 8, 48]
Answer: 3
#include <stdio.h>

int longestNiceSubarray(int *nums, int n)
{
    int mask = 0;     // OR of all elements in current window
    int left = 0;
    int best = 0;

    for (int right = 0; right < n; right++) {
        // While there is a bit conflict between nums[right] and window mask
        while ((mask & nums[right]) != 0) {
            // Remove nums[left] from window
            mask ^= nums[left];
            left++;
        }

        // Now it's safe to include nums[right]
        mask |= nums[right];

        int len = right - left + 1;
        if (len > best) {
            best = len;
        }
    }

    return best;
}

int main(void)
{
    int nums1[] = {1, 3, 8, 48, 10};
    int n1 = sizeof(nums1) / sizeof(nums1[0]);

    printf("Longest nice subarray length = %d\n",
           longestNiceSubarray(nums1, n1)); // expected 3

    int nums2[] = {3, 4, 5, 2};
    int n2 = sizeof(nums2) / sizeof(nums2[0]);

    printf("Longest nice subarray length = %d\n",
           longestNiceSubarray(nums2, n2)); // expected 2

    return 0;
}
