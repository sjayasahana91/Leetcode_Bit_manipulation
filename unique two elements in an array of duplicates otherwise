You are given an integer array nums where exactly two elements appear once and all the other elements appear exactly twice.
Return the two elements that appear once, in any order.
You must solve it in O(n) time and O(1) extra space.

#include <stdio.h>
#include <stdint.h>

void findTwoUniques(int arr[], int n) {
    int xor = 0;

    // Step 1: XOR everything
    for (int i = 0; i < n; i++)
        xor ^= arr[i];

    // xor now contains x ^ y (two unique numbers)

    // Step 2: Find rightmost set bit (differentiating bit)
    int diffBit = xor & (-xor);   // isolate rightmost 1-bit

    int x = 0, y = 0;

    // Step 3: Separate into two groups and XOR individually
    for (int i = 0; i < n; i++) {
        if (arr[i] & diffBit)
            x ^= arr[i];   // Group 1
        else
            y ^= arr[i];   // Group 2
    }

    printf("Unique numbers are: %d and %d\n", x, y);
}

int main() {
    int arr[] = {1, 2, 1, 3, 2, 5};
    int n = sizeof(arr) / sizeof(arr[0]);
    findTwoUniques(arr, n);
    return 0;
}
