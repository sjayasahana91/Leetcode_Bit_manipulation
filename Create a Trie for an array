#include <stdio.h>
#include <stdlib.h>
typedef struct trienode{
  struct trienode *child[2];
  int is_terminal;
}trienode;

trienode* create_trie_node()
{
  trienode *node = malloc(sizeof(trienode));
  if(node != NULL)
  {
  //Check for NULL
  node->child[0] = NULL;
  node->child[1] = NULL;
  node->is_terminal = 0;
  }
  else {
  printf("Node creation error");
  }
  return node;
}

int insert_num_to_trie_node(trienode *root, int num, int max_bits)
{
  trienode *curr = root;
  for(int i=max_bits-1; i>=0; i--)
  {
    int bit = (num >> i) & 1;
    if(!curr->child[bit])
    {
      trienode *new = create_trie_node();
      if(new)
      {
        curr->child[bit] = new;
      }
      else 
      {
        return 0;
      }
    }
    curr = curr->child[bit];
  }
  curr->is_terminal = 1;
  return 1;
}
int compute_max_bits(int *a, int len)
{
  int max = 0;
  for(int i=0;i<len;i++)
  {
    if(a[i]>max)
    {
      max = a[i];
    }
  }
  int max_bits =0;
  while(max)
  {
    max>>=1;
    max_bits++;
  }
  return max_bits;
}

int create_trie_for_array(trienode *root, int *a, int len, int max_bits)
{
  
  for(int i=0;i<len;i++)
  {
   if(!insert_num_to_trie_node(root, a[i], max_bits))
   {
    printf("Insertion error: Index %d, num:%d", i,a[i]);
    return 0;
   }
  }
  return 1;
}

int trie_contains(trienode *root, int num, int max_bits)
{
  trienode *curr =root;
  for(int i=max_bits-1;i>=0;i--)
  {
    int bit = (num>>i) & 1;
    if(curr->child[bit])
    {
      curr = curr->child[bit];
    }
    else {
      return 0;
    }
  }
  return curr->is_terminal;

}

// To execute C, please define "int main()"

int main() {
  int a[5] = {10, 20, 30, 40, 50};
  int arr_len = sizeof(a)/sizeof(int);
  int max_bits = compute_max_bits(a, arr_len);
  trienode *root = create_trie_node();

  if(create_trie_for_array(root, a, sizeof(a)/sizeof(int), max_bits))
  {
    int b[4] = {20,30,85,50};
    for(int i=0;i<4;i++)
    {
      if(trie_contains(root, b[i], max_bits))
      {
        printf("Num present in trie: %d \n", b[i]);
      }
      else {
         printf("Num not present in trie: %d \n", b[i]);
      }
    }
  }

  return 0;
 }
