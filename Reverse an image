#include <stdio.h>

// To execute C, please define "int main()"

void reverse_image(int row, int col, int (*a)[col])
{
  for(int i=0; i < row ; i++)
  {
    for(int j=0; j<col/2;j++)
    {
      int temp = a[i][j]^1;
      a[i][j] = a[i][col-j-1]^1;
      a[i][col-j-1] = temp;
    }
  }

}
int main() {
  int a[3][4] = {{1,0,0,1},{1,1,0,1},{0,0,1,1}};
  
  reverse_image(3, 4, a);

  for(int i=0;i<3; i++)
  {
    for(int j=0;j<4;j++)
    {
      printf("%d",a[i][j]);
    }
    printf("\n");
  }


  return 0;
}
