#include <stdio.h>
#include <stdlib.h>
int find_max_profit(int *a, int len)
{
  int minsofar = 10000;
  int largest_prof_so_far = 0;

  for(int i=0;i<len;i++)
  {
    if(a[i]<minsofar)
    {
      minsofar = a[i];
    }
    if((a[i] > minsofar) && (a[i]-minsofar >largest_prof_so_far))
    {
      largest_prof_so_far = a[i] - minsofar;
    }
  }
  return largest_prof_so_far;
  
}

int main()
{
  int a[5] = {10,40,20,100, 60};
  printf("Largest Profit: %d", find_max_profit(a, sizeof(a)/sizeof(int)));
}
